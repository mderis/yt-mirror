#!/bin/sh
# Runs uv for developer commands, for example: scripts/uv run pytest
#
# It uses the copy of uv that ./start put into tools/, with the same folders,
# so the app and the developer tools share one Python environment and nothing
# is installed system-wide. Without that copy it falls back to a uv on PATH.

set -eu

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
TOOLS_DIR="$ROOT/tools"

if [ -x "$TOOLS_DIR/uv/uv" ]; then
    export UV_PYTHON_INSTALL_DIR="$TOOLS_DIR/python"
    export UV_PROJECT_ENVIRONMENT="$TOOLS_DIR/venv"
    export UV_CACHE_DIR="$TOOLS_DIR/uv-cache"
    export UV_PYTHON_PREFERENCE="only-managed"
    exec "$TOOLS_DIR/uv/uv" "$@"
fi

if command -v uv >/dev/null 2>&1; then
    exec uv "$@"
fi

printf '%s\n' "uv was not found. Run ./start once (it downloads uv into tools/), or install uv yourself." >&2
exit 1
